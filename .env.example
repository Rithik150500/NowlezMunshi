# NowLez — example environment. Copy to .env and fill in. Never commit real secrets.
# GET /config on the running server reports which of these are live vs offline fakes/stubs.

# --- Court-data source (ADR-0002). Default `mock`. `ecourts-mobile` (ADR-0016) speaks the VERIFIED
#     eCourts protocol (codec in ecourts-codec.ts, KAT-proven); live use still needs legal sign-off
#     (off by default). `ecourts-web` / `commercial` are not yet built. ---
# NOWLEZ_COURT_SOURCE=mock
# Base URL for the eCourts mobile backend. Default is the District-Courts base; set the High-Court
# base (…/ecourt_mobile_HC/) for HC use:
# NOWLEZ_ECOURTS_BASE_URL=https://app.ecourts.gov.in/ecourt_mobile_DC/
# Session identity for the 401 token bootstrap (uid = deviceId:packageName). Defaults match the app
# (deviceId "324456", package in.gov.ecourts.eCourtsServices); set a stable device id of your own:
# NOWLEZ_ECOURTS_DEVICE_ID=
# NOWLEZ_ECOURTS_PACKAGE=in.gov.ecourts.eCourtsServices
# Operational discipline at the source seam (apply to real sources before any live traffic):
#   cache TTL — the fetch-once/fan-out window; keep it well below the daily refresh interval:
# NOWLEZ_COURT_CACHE_TTL_MS=60000
#   minimum gap between upstream calls (rate limit):
# NOWLEZ_COURT_MIN_INTERVAL_MS=1000

# --- Model endpoint for the real (OpenAI-compatible) ModelClient (see packages/model, ADR-0009) ---
# Works with self-hosted vLLM / Ollama / LM Studio, or a hosted provider
# (including Gemini's OpenAI-compatibility endpoint).
NOWLEZ_MODEL_BASE_URL=http://localhost:11434/v1
NOWLEZ_MODEL_SMALL=your-smaller-gemma-4-model-id
NOWLEZ_MODEL_LARGE=your-larger-gemma-4-model-id
# Bearer token, only if your endpoint requires one:
# NOWLEZ_MODEL_API_KEY=your-key

# --- Web search for the Munshi's web_search tool (Tavily; see packages/web-search, ADR-0010) ---
# TAVILY_API_KEY=tvly-your-key

# --- WhatsApp channel (Meta Cloud API; see packages/whatsapp, ADR-0013) ---
# WHATSAPP_TOKEN=your-meta-access-token
# WHATSAPP_PHONE_ID=your-phone-number-id
# WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token
# App secret for inbound-webhook authenticity (X-Hub-Signature-256). Set in production so the
# server rejects spoofed POSTs; empty = webhook accepted unverified (dev only):
# WHATSAPP_APP_SECRET=your-meta-app-secret
# Restrict who may drive the channel (comma-separated phone numbers); empty = open to any sender:
# WHATSAPP_ALLOWED_SENDERS=919812345678
# Push new tracking alerts to this number (single-tenant stopgap; see ADR-0015):
# WHATSAPP_ALERT_RECIPIENT=919812345678

# --- Auth & identity (apps/server; see packages/auth, ADR-0019) ---
# Phone OTP is delivered over WhatsApp when the channel above is live, else a dev fake (the code is
# recorded, not sent). For Google sign-in, set the OAuth client id the server verifies ID tokens
# against; unset = an offline fake verifier (dev/tests). Email + password needs no config.
# GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# The same OAuth client id, exposed to the web build so its Login screen can render the Google
# button (Vite only forwards VITE_-prefixed vars to the browser; it's a public client id). Unset =
# the web shows a hint instead of the Google button; password + phone OTP still work.
# VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# Require a valid session on the firm-owned routes (401 otherwise). Default off so dev works without
# a token; set in production. (/health, /config, /auth/*, and /whatsapp stay public.)
# NOWLEZ_REQUIRE_AUTH=1

# --- Notification preferences (single-tenant; what reaches the recipient above) ---
# Mute alert pushes (default on); 0/false to keep alerts in the in-app feed only:
# NOWLEZ_PUSH_ALERTS=0
# Restrict which alert kinds push (comma-separated: new-order,case-update); unset = all:
# NOWLEZ_ALERT_KINDS=new-order
# Push a daily briefing (imminent hearings + unread alerts) each refresh cycle:
# NOWLEZ_DAILY_BRIEFING=1

# --- Document rendering (apps/server; ADR-0008, ADR-0005) ---
# Real rendering for ingestion: pdfjs-dist + @napi-rs/canvas for PDF pages, LibreOffice for
# docx->pdf. Default = offline fake (deterministic; used by tests and the mock court source).
# Set to `pdfjs` to enable the real renderer:
# NOWLEZ_PDF_RENDERER=pdfjs
# Path to the LibreOffice binary for docx->pdf (soffice.com on Windows, soffice on Linux):
# NOWLEZ_SOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.com

# --- Daily refresh scheduler (apps/server; see ADR-0015) ---
# Run the tracking refresh + alert delivery on a timer. Unset/0 = on demand only.
# NOWLEZ_REFRESH_INTERVAL_MS=86400000

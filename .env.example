# NowLez — example environment. Copy to .env and fill in. Never commit real secrets.
# GET /config on the running server reports which of these are live vs offline fakes/stubs.

# --- Court-data source (ADR-0002). Default `mock`. `ecourts-mobile` is a PROVISIONAL adapter
#     (ADR-0016) — wired but unverified against the live endpoint (needs the real request-param
#     codec + a MITM capture + legal sign-off); `ecourts-web` / `commercial` are not yet built. ---
# NOWLEZ_COURT_SOURCE=mock
# Base URL for the eCourts mobile backend (provisional default below):
# NOWLEZ_ECOURTS_BASE_URL=https://app.ecourts.gov.in
# Operational discipline at the source seam (apply to real sources before any live traffic):
#   cache TTL — the fetch-once/fan-out window; keep it well below the daily refresh interval:
# NOWLEZ_COURT_CACHE_TTL_MS=60000
#   minimum gap between upstream calls (rate limit):
# NOWLEZ_COURT_MIN_INTERVAL_MS=1000

# --- Model endpoint for the real (OpenAI-compatible) ModelClient (see packages/model, ADR-0009) ---
# Works with self-hosted vLLM / Ollama / LM Studio, or a hosted provider
# (including Gemini's OpenAI-compatibility endpoint).
NOWLEZ_MODEL_BASE_URL=http://localhost:11434/v1
NOWLEZ_MODEL_SMALL=your-smaller-gemma-4-model-id
NOWLEZ_MODEL_LARGE=your-larger-gemma-4-model-id
# Bearer token, only if your endpoint requires one:
# NOWLEZ_MODEL_API_KEY=your-key

# --- Web search for the Munshi's web_search tool (Tavily; see packages/web-search, ADR-0010) ---
# TAVILY_API_KEY=tvly-your-key

# --- WhatsApp channel (Meta Cloud API; see packages/whatsapp, ADR-0013) ---
# WHATSAPP_TOKEN=your-meta-access-token
# WHATSAPP_PHONE_ID=your-phone-number-id
# WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token
# App secret for inbound-webhook authenticity (X-Hub-Signature-256). Set in production so the
# server rejects spoofed POSTs; empty = webhook accepted unverified (dev only):
# WHATSAPP_APP_SECRET=your-meta-app-secret
# Restrict who may drive the channel (comma-separated phone numbers); empty = open to any sender:
# WHATSAPP_ALLOWED_SENDERS=919812345678
# Push new tracking alerts to this number (single-tenant stopgap; see ADR-0015):
# WHATSAPP_ALERT_RECIPIENT=919812345678

# --- Daily refresh scheduler (apps/server; see ADR-0015) ---
# Run the tracking refresh + alert delivery on a timer. Unset/0 = on demand only.
# NOWLEZ_REFRESH_INTERVAL_MS=86400000

{
  "name": "nowlez",
  "version": "0.0.0",
  "private": true,
  "description": "NowLez — legal practice-management platform for Indian advocates (eCourts + AI Munshi). Phase 1 scaffold.",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "typecheck:web": "tsc -p apps/web/tsconfig.json",
    "build": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "cli": "tsx apps/cli/src/main.ts",
    "server": "tsx apps/server/src/main.ts",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run typecheck:web && pnpm run test"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/node": "^25.9.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
